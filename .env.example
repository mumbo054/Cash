# ==============================================================================
# CASH FINTECH WALLET — ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Only expose the Project URL and the Publishable/Anon Key to the frontend.
# NEVER expose the service_role key or database password in any client-facing code!
# The anon key is safe for client applications because data access is strictly
# governed by PostgreSQL Row Level Security (RLS) policies.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://pijqwveothxgtxcsxkoj.supabase.co

# Supabase Anonymous / Publishable Key (publicly readable via browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App configuration
VITE_APP_NAME="Cash"
VITE_DEFAULT_CURRENCY="INR"
